  object PatientSearchCDS: TClientDataSet
    Aggregates = <>
    CommandText = 
      #13#10'    select p.hos_guid,p.hn,concat(p.pname,p.fname," ",p.lname)' +
      ' as patient_name , '#13#10'     p.addrpart,p.moopart,p.road,p.birthday' +
      ', t.full_name as address_name,p.cid,p.death,p.admit,p.last_visit' +
      ' ,p.oldcode ,'#13#10'    concat(p.fathername," ",p.fatherlname) as fat' +
      'her_name ,concat(p.mathername," ",p.motherlname)  as mother_name' +
      ',py.name as pttype_name '#13#10'    from patient p '#13#10'    left outer jo' +
      'in thaiaddress t on t.chwpart = p.chwpart and t.amppart = p.ampp' +
      'art and t.tmbpart = p.tmbpart and t.codetype="3" '#13#10'     left out' +
      'er join pttype py on py.pttype = p.pttype '#13#10'     where p.hn like' +
      ' '#39'000000%'#39'    limit 10'#13#10
    Params = <>
    ReadOnly = True
    AfterOpen = PatientSearchCDSAfterOpen
    Left = 445
    Top = 306
  end
  object PatientSearchDS: TDataSource
    DataSet = PatientSearchCDS
    Left = 547
    Top = 304
  end
